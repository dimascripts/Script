Position = TargetPos
    })
    flyTween:Play()
    
    -- Логика стандартной детонации
    flyTween.Completed:Connect(function()
        local finalPos = EnergyBall.Position
        EnergyBall:Destroy()
        
        -- Срабатывает стандартный классический взрыв Roblox
        local Explosion = Instance.new("Explosion")
